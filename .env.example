# Optional Groq AI powers natural-language media recommendations and @Zangetsu conversations. No key = local
# recommendation ranking and the normal mention/help reply. Create a key at https://console.groq.com/keys.
# RECOMMENDATION_AI_MODEL controls catalogue recommendation ranking only. Conversational chat is pinned to
# openai/gpt-oss-20b and uses Groq browser search only for current-information or explicit online-search requests.
GROQ_API_KEY=
RECOMMENDATION_AI_MODEL=openai/gpt-oss-20b